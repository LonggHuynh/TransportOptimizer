{
  "GOOGLE_APPLICATION_CREDENTIALS": "../../.secrets/gcp-sa.json",
  "OpenTelemetry": {
    "ServiceName": "transport-optimizer-backend",
    "OtlpEndpoint": "http://otel-collector:4318/v1/traces",
    "OtlpProtocol": "http/protobuf"
  },
  "GoogleMaps": {
    "QuotaProject": "pathoptimizer-486102",
    "TilesApiUrl": "https://tile.googleapis.com/v1",
    "PlacesApiUrl": "https://places.googleapis.com/v1",
    "RoutesApiUrl": "https://routes.googleapis.com",
    "TileSize": 256,
    "TileMapType": "roadmap",
    "TileLanguage": "en-US",
    "TileRegion": "US"
  },
  "CorsSettings": {
    "AllowedOrigins": ["http://localhost:3000"]
  },
  "Redis": {
    "ConnectionString": "redis:6379",
    "IamAuthEnabled": false,
    "IamRefreshInterval": "00:45:00",
    "IamScopes": [
      "https://www.googleapis.com/auth/cloud-platform"
    ],
    "AbortOnConnectFail": false
  }
}
