{
    "name": "TransportOptimizer Dev",
    "dockerComposeFile": "docker-compose.yml",
    "service": "devcontainer",
    "workspaceFolder": "/workspaces/TransportOptimizer",
    "runServices": [
        "devcontainer",
        "redis",
        "jaeger",
        "otel-collector"
    ],
    "shutdownAction": "stopCompose",
    "features": {
        "ghcr.io/devcontainers/features/git:1": {},
        "ghcr.io/devcontainers/features/git-lfs:1": {},
        "ghcr.io/devcontainers/features/node:1": {
            "version": "20",
            "nvmVersion": "latest"
        },
        "ghcr.io/devcontainers/features/dotnet:2": {
            "version": "8.0"
        },
        "ghcr.io/devcontainers/features/python:1": {
            "version": "3.12",
            "installTools": true,
            "toolsToInstall": "pipenv"
        }
    },
    "containerEnv": {
        "PIPENV_VENV_IN_PROJECT": "1"
    },
    "remoteEnv": {
        "GOOGLE_MAPS_API_KEY": "${localEnv:GOOGLE_MAPS_API_KEY}",
        "GOOGLE_APPLICATION_CREDENTIALS_JSON_B64": "${localEnv:GOOGLE_APPLICATION_CREDENTIALS_JSON_B64}",
        "GOOGLE_APPLICATION_CREDENTIALS": "/workspaces/TransportOptimizer/.secrets/gcp-sa.json"
    },
    "postCreateCommand": "bash .devcontainer/post-create.sh",
    "postStartCommand": "mkdir -p /workspaces/TransportOptimizer/.secrets && if [ -n \"$GOOGLE_APPLICATION_CREDENTIALS_JSON_B64\" ]; then echo \"$GOOGLE_APPLICATION_CREDENTIALS_JSON_B64\" | base64 -d > /workspaces/TransportOptimizer/.secrets/gcp-sa.json && chmod 600 /workspaces/TransportOptimizer/.secrets/gcp-sa.json; fi",
    "forwardPorts": [
        3000,
        5259,
        7077
    ],
    "portsAttributes": {
        "3000": {
            "label": "Frontend (Vite)",
            "onAutoForward": "openBrowser"
        },
        "5259": {
            "label": "Backend API (HTTP)"
        },
        "7077": {
            "label": "Backend API (HTTPS)"
        }
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-dotnettools.csharp",
                "ms-python.python",
                "ms-python.vscode-pylance",
                "dbaeumer.vscode-eslint",
                "esbenp.prettier-vscode",
                "ms-azuretools.vscode-docker"
            ]
        }
    }
}
